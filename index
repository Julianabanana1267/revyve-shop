<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Revyve Shop</title>
<style>
  :root { --ice:#D7F8FC; --off:#F8F8F8; --navy:#092857; --err:#b00020; }
  * { box-sizing:border-box; }
  body { margin:0; font-family:Georgia, "Times New Roman", serif; background:var(--ice); color:var(--navy); }
  .wrap { max-width:1000px; margin:0 auto; padding:0 20px 48px; }
  .top { display:flex; justify-content:space-between; align-items:center; border-bottom:1px dashed var(--navy); padding:14px 0; }
  .brand { font-size:27px; font-weight:bold; letter-spacing:3px; }
  button { background:var(--navy); color:var(--off); border:1px solid var(--navy); border-radius:4px; padding:12px 18px; cursor:pointer; font-size:14px; font-family:inherit; }
  button:hover { background:var(--off); color:var(--navy); }
  .linkbtn { background:none; border:0; color:var(--navy); padding:0; text-decoration:underline; font-size:15px; }
  .linkbtn:hover { background:none; opacity:.7; }

  /* MAIN PAGE GRID */
  .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(250px,1fr)); gap:28px; margin-top:28px; }
  .tile { text-align:center; cursor:pointer; }
  .imgbox { width:100%; aspect-ratio:1/1; background:var(--off); overflow:hidden; border-radius:2px; display:flex; align-items:center; justify-content:center; }
  .imgbox img { width:100%; height:100%; object-fit:cover; display:block; }
  .tile h2 { font-size:22px; margin:18px 0 10px; text-decoration:underline; line-height:1.25; }
  .tile .price { font-size:17px; margin:0; }
  .ph { padding:16px; font-size:15px; color:var(--navy); opacity:.6; text-align:center; }

  /* PRODUCT PAGE */
  .detail { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:40px; margin-top:24px; align-items:start; }
  .detail .imgbox { aspect-ratio:3/4; }
  .detail h1 { font-size:40px; line-height:1.15; margin:0 0 20px; color:#222; }
  .detail .desc { font-size:17px; line-height:1.65; font-style:italic; margin:0 0 20px; color:#111; }
  .detail .price { font-size:24px; font-weight:bold; margin:0 0 6px; }
  .tag { font-size:11px; letter-spacing:2px; margin:0 0 8px; }
  label { display:block; margin:14px 0 6px; font-size:14px; font-weight:bold; }
  select, input { width:100%; padding:11px; border:1px solid var(--navy); border-radius:4px; background:var(--off); color:var(--navy); font-size:15px; font-family:inherit; }
  input.bad, select.bad { border-color:var(--err); border-width:2px; }
  .add { width:100%; margin-top:16px; font-weight:bold; }
  .msg { font-size:14px; min-height:18px; margin-top:8px; }
  .err { color:var(--err); font-size:13px; margin-top:4px; }

  /* CART / CHECKOUT */
  .cart-item { padding:16px 0; border-bottom:1px solid var(--navy); display:flex; gap:14px; align-items:center; }
  .cart-item .thumb { width:70px; height:70px; flex:none; background:var(--off); }
  .cart-item .thumb img { width:100%; height:100%; object-fit:cover; display:block; }
  .cart-item p { margin:4px 0; }
  .remove { background:var(--off); color:var(--navy); margin-top:6px; padding:8px 14px; }
  .remove:hover { background:var(--navy); color:var(--off); }
  .total { font-size:20px; font-weight:bold; margin:20px 0; }
  .actions { display:flex; gap:10px; flex-wrap:wrap; margin-top:16px; }
  .row2 { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  .box { background:var(--off); border-radius:8px; padding:20px; margin-top:16px; }
  h2.page { font-size:28px; margin:24px 0 0; }
  .hidden { display:none; }
  @media (max-width:700px){
    .detail { grid-template-columns:1fr; gap:20px; }
    .detail h1 { font-size:30px; }
    .row2 { grid-template-columns:1fr; }
  }
</style>
</head>
<body>
<div class="wrap">
  <div class="top">
    <div class="brand">revyve</div>
    <button id="cartBtn" type="button">Cart (<span id="count">0</span>)</button>
  </div>

  <!-- MAIN PAGE -->
  <section id="shopPage"><div class="grid" id="grid"></div></section>

  <!-- PRODUCT SUBPAGE -->
  <section id="productPage" class="hidden">
    <p style="margin:18px 0 0"><button class="linkbtn" id="backToShop" type="button">&larr; Back to all products</button></p>
    <div class="detail">
      <div class="imgbox" id="pImg"></div>
      <div>
        <h1 id="pName"></h1>
        <p class="desc" id="pDesc"></p>
        <p class="price" id="pPrice"></p>
        <label for="pSize">Select your size</label>
        <select id="pSize"></select>
        <label for="pQty">Quantity</label>
        <input id="pQty" type="number" min="1" max="10" value="1">
        <button class="add" id="pAdd" type="button">ADD TO CART</button>
        <div class="msg" id="pMsg" aria-live="polite"></div>
      </div>
    </div>
  </section>

  <!-- CART PAGE -->
  <section id="cartPage" class="hidden">
    <h2 class="page">Your shopping bag</h2>
    <div id="items"></div>
    <div class="total" id="totalRow">Total: <span id="total"></span></div>
    <div class="actions">
      <button id="backBtn" type="button">CONTINUE SHOPPING</button>
      <button id="toCheckoutBtn" type="button">CONTINUE TO CHECKOUT</button>
    </div>
    <p class="msg" id="cartMsg"></p>
  </section>

  <!-- CHECKOUT PAGE -->
  <section id="checkoutPage" class="hidden">
    <h2 class="page">Checkout</h2>
    <div class="box">
      <form id="form" novalidate>
        <label for="name">Full name</label>
        <input id="name" type="text" autocomplete="name">
        <div class="err" id="e-name"></div>

        <label for="email">Email</label>
        <input id="email" type="email" autocomplete="email" placeholder="you@example.com">
        <div class="err" id="e-email"></div>

        <label for="phone">Phone number</label>
        <input id="phone" type="tel" autocomplete="tel" placeholder="0400 000 000">
        <div class="err" id="e-phone"></div>

        <label for="street">Street address</label>
        <input id="street" type="text" autocomplete="address-line1" placeholder="12 Example Street">
        <div class="err" id="e-street"></div>

        <div class="row2">
          <div>
            <label for="suburb">Suburb</label>
            <input id="suburb" type="text" autocomplete="address-level2">
            <div class="err" id="e-suburb"></div>
          </div>
          <div>
            <label for="state">State</label>
            <select id="state">
              <option value="">Choose</option>
              <option>QLD</option><option>NSW</option><option>VIC</option><option>TAS</option>
              <option>SA</option><option>WA</option><option>NT</option><option>ACT</option>
            </select>
            <div class="err" id="e-state"></div>
          </div>
        </div>

        <label for="postcode">Postcode</label>
        <input id="postcode" type="text" inputmode="numeric" maxlength="4" autocomplete="postal-code" placeholder="4000">
        <div class="err" id="e-postcode"></div>

        <div class="actions">
          <button type="button" id="backToCartBtn">BACK TO CART</button>
          <button type="submit">PLACE ORDER</button>
        </div>
      </form>
    </div>
  </section>

  <!-- CONFIRMATION -->
  <section id="donePage" class="hidden">
    <h2 class="page">Thank you!</h2>
    <div class="box" id="summary"></div>
    <div class="actions"><button id="newBtn" type="button">BACK TO SHOP</button></div>
  </section>
</div>

<script>
// ================= EDIT YOUR PRODUCTS HERE =================
// image: your photos are already built in. To swap one, replace the long
//   data:image text with a Google Drive share link or any direct image link.
var PRODUCTS = [
  { id:"coastline", name:"Coastline Plunge Wrap", price:75, image:"data:image/jpeg;base64,",
    desc:"Retro summer energy reimagined through circular fashion principles. Cut from a premium recycled cotton blend knit made from post-industrial textile waste, this scoop top features dynamic contrast binding and a flexible, contoured silhouette and loose, blended shapes. By giving existing cotton fibers a second life, this piece significantly reduces landfill waste, carbon emissions, and water usage compared to conventional manufacturing." },
  { id:"solsea", name:"Sol-Sea Breeze Tube Top", price:65, image:"data:image/jpeg;base64,",
    desc:"Breezy, romantic, and thoughtfully engineered for warmer weather. Crafted from 100% organic, rain-fed linen, this strapless bandeau features soft shirring and an airy ruffled silhouette that lets your skin breathe naturally. Free from synthetic microfibers, petroleum-derived polyester, and harsh chemical treatments, it offers pure, lightweight comfort with a zero-waste spirit." },
  { id:"wave", name:"Wave Essentials Scoop Tank", price:60, image:"data:image/jpeg;base64,",   // CHECK THIS PRICE
    desc:"The ultimate everyday essential, elevated by sustainable textile innovation. Cut from ECONYL\u00AE regenerated nylon rib\u2014a high-performance material crafted from rescued ocean plastics, ghost fishing nets, and discarded fabric scraps\u2014this scoop-neck top offers four-way stretch, exceptional durability, and a clean, minimalist fit that layer easily beneath light jackets or stands boldly on its own." },
  { id:"solstice", name:"Solstice Tie Crop", price:65, image:"data:image/jpeg;base64,",
    desc:"Effortless style meets conscious design. Ethically crafted from 100% GOTS-certified organic cotton, this front-tie crop top offers an ultra-soft texture and breathable comfort for sunny days. Featuring a adjustable center knot and subtle short sleeves, it pairs seamlessly with high-waisted linen trousers or your favorite vintage denim. Designed using low-impact, non-toxic dyes to keep synthetic chemicals out of our waterways while keeping your wardrobe sustainably elevated." },
  { id:"azure", name:"Azure Asymmetric Top", price:95, image:"data:image/jpeg;base64,",
    desc:"Sculpted for modern elegance with a gentle environmental footprint. This asymmetric top is tailored from sustainably harvested Tencel\u2122 Modal, renowned for its silky drape, moisture-wicking properties, and closed-loop production process that recycles 99% of water and solvents. The softly gathered side detail creates a flattering, molded fit that transitions effortlessly from beachside afternoons to golden-hour dinners." },
  { id:"mariner", name:"Mariner Halter Tank", price:65, image:"data:image/jpeg;base64,",
    desc:"A nod to classic resort fashion, updated for the eco-conscious wardrobe. Spun from low-impact organic jersey cotton with a touch of elastane for shape retention, this nautical-striped halter delivers a secure, sun-ready fit without stretching out over time. Built with durable, high-quality finishes to ensure long-lasting wear, reducing the need for frequent replacements and keeping fast fashion out of landfills." }
];
var SIZES = ["XS", "S", "M", "L", "XL"];
// ===========================================================

var cart = [];
var current = null;
var KEY = "revyve-cart-v4";
try { cart = JSON.parse(window.localStorage.getItem(KEY) || "[]"); if (!Array.isArray(cart)) cart = []; } catch (e) { cart = []; }
function save() { try { window.localStorage.setItem(KEY, JSON.stringify(cart)); } catch (e) {} }

function $(id) { return document.getElementById(id); }
function money(n) { return "$" + n.toFixed(2); }
function esc(s) { return String(s).replace(/[&<>"']/g, function (c) { return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]; }); }
function findProduct(id) { for (var i = 0; i < PRODUCTS.length; i++) if (PRODUCTS[i].id === id) return PRODUCTS[i]; return null; }

// Turns a Google Drive share link into a direct image link.
function imgUrl(u) {
  if (!u) return "";
  var m = u.match(/drive\.google\.com\/file\/d\/([^\/?#]+)/) || u.match(/drive\.google\.com\/(?:open|uc)\?(?:[^#]*&)?id=([^&#]+)/);
  return m ? "https://drive.google.com/thumbnail?id=" + m[1] + "&sz=w1200" : u;
}
function fillImage(box, p) {
  box.innerHTML = "";
  var url = imgUrl(p.image);
  if (url) {
    var img = document.createElement("img");
    img.alt = p.name; img.src = url;
    img.onerror = function () { box.innerHTML = '<div class="ph">' + esc(p.name) + '<br>(photo link not working)</div>'; };
    box.appendChild(img);
  } else {
    box.innerHTML = '<div class="ph">' + esc(p.name) + '<br>(add photo link)</div>';
  }
}

function cartTotal() { var t = 0; cart.forEach(function (i) { t += i.price * i.quantity; }); return t; }
function renderCount() { var c = 0; cart.forEach(function (i) { c += i.quantity; }); $("count").textContent = c; }

// ---------- Main page ----------
function buildShop() {
  var grid = $("grid");
  PRODUCTS.forEach(function (p) {
    var tile = document.createElement("div");
    tile.className = "tile";
    tile.tabIndex = 0;
    tile.setAttribute("role", "link");
    tile.innerHTML = '<div class="imgbox"></div><h2></h2><p class="price"></p>';
    fillImage(tile.querySelector(".imgbox"), p);
    tile.querySelector("h2").textContent = p.name;
    tile.querySelector(".price").textContent = money(p.price);
    var go = function () { openProduct(p.id); };
    tile.addEventListener("click", go);
    tile.addEventListener("keydown", function (e) { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); go(); } });
    grid.appendChild(tile);
  });
}

// ---------- Product subpage ----------
function openProduct(id) {
  var p = findProduct(id);
  if (!p) return;
  current = p;
  fillImage($("pImg"), p);
  $("pName").textContent = p.name;
  $("pDesc").textContent = p.desc;
  $("pPrice").textContent = money(p.price) + " AUD";
  var opts = '<option value="">Choose a size</option>';
  SIZES.forEach(function (s) { opts += '<option value="' + s + '">' + s + '</option>'; });
  $("pSize").innerHTML = opts;
  $("pQty").value = 1;
  $("pMsg").textContent = "";
  show("product");
}

$("pAdd").addEventListener("click", function () {
  var p = current; if (!p) return;
  var size = $("pSize").value;
  var qty = parseInt($("pQty").value, 10);
  var msg = $("pMsg");
  if (!size) { msg.textContent = "Please choose a size first."; return; }
  if (!(qty >= 1 && qty <= 10)) { msg.textContent = "Please enter a quantity from 1 to 10."; return; }
  var found = null;
  cart.forEach(function (i) { if (i.id === p.id && i.size === size) found = i; });
  if (found) {
    if (found.quantity + qty > 10) { msg.textContent = "Maximum is 10 per size."; return; }
    found.quantity += qty;
  } else {
    cart.push({ id:p.id, name:p.name, price:p.price, size:size, quantity:qty });
  }
  save(); renderCount();
  msg.textContent = "Added to your cart!";
});

// ---------- Cart ----------
function renderCart() {
  var box = $("items");
  box.innerHTML = "";
  if (cart.length === 0) box.textContent = "Your cart is empty.";
  cart.forEach(function (item, index) {
    var row = document.createElement("div");
    row.className = "cart-item";
    var thumb = document.createElement("div"); thumb.className = "thumb";
    var p = findProduct(item.id);
    if (p && imgUrl(p.image)) { var im = document.createElement("img"); im.alt = ""; im.src = imgUrl(p.image); thumb.appendChild(im); }
    var info = document.createElement("div");
    var t = document.createElement("strong"); t.textContent = item.name;
    var d = document.createElement("p"); d.textContent = "Size: " + item.size + " \u00B7 Quantity: " + item.quantity;
    var pr = document.createElement("p"); pr.textContent = money(item.price * item.quantity);
    var rm = document.createElement("button");
    rm.type = "button"; rm.className = "remove"; rm.textContent = "Remove";
    rm.addEventListener("click", function () { cart.splice(index, 1); save(); renderCount(); renderCart(); });
    info.appendChild(t); info.appendChild(d); info.appendChild(pr); info.appendChild(rm);
    row.appendChild(thumb); row.appendChild(info);
    box.appendChild(row);
  });
  $("total").textContent = money(cartTotal()) + " AUD";
  $("totalRow").classList.toggle("hidden", cart.length === 0);
}

function show(page) {
  ["shop","product","cart","checkout","done"].forEach(function (p) {
    $(p + "Page").classList.toggle("hidden", p !== page);
  });
  if (page === "cart") { $("cartMsg").textContent = ""; renderCart(); }
  try { window.scrollTo(0, 0); } catch (e) {}
}

// ---------- Validation ----------
function setErr(field, text) {
  $("e-" + field).textContent = text || "";
  $(field).classList.toggle("bad", !!text);
  return !text;
}
function validate() {
  var ok = true;
  var name = $("name").value.trim();
  ok = setErr("name", (name.length >= 2 && /^[A-Za-z][A-Za-z '\-\.]+$/.test(name)) ? "" : "Please enter your full name.") && ok;
  var email = $("email").value.trim();
  ok = setErr("email", /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email) ? "" : "Please enter a valid email with an @ symbol, e.g. you@example.com.") && ok;
  var phone = $("phone").value.replace(/[\s\-()]/g, "");
  ok = setErr("phone", /^\+?[0-9]{8,15}$/.test(phone) ? "" : "Please enter a valid phone number (8\u201315 digits).") && ok;
  var street = $("street").value.trim();
  ok = setErr("street", (/\d/.test(street) && /[A-Za-z]{3,}/.test(street)) ? "" : "Please enter a street number and name, e.g. 12 Example Street.") && ok;
  var suburb = $("suburb").value.trim();
  ok = setErr("suburb", /^[A-Za-z][A-Za-z '\-\.]+$/.test(suburb) ? "" : "Please enter your suburb.") && ok;
  ok = setErr("state", $("state").value ? "" : "Please choose a state.") && ok;
  ok = setErr("postcode", /^\d{4}$/.test($("postcode").value.trim()) ? "" : "Please enter a 4-digit postcode.") && ok;
  return ok;
}

// ---------- Events ----------
$("cartBtn").addEventListener("click", function () { show("cart"); });
$("backToShop").addEventListener("click", function () { show("shop"); });
$("backBtn").addEventListener("click", function () { show("shop"); });
$("toCheckoutBtn").addEventListener("click", function () {
  if (cart.length === 0) { $("cartMsg").textContent = "Your cart is empty \u2013 add something first."; return; }
  show("checkout");
});
$("backToCartBtn").addEventListener("click", function () { show("cart"); });
$("newBtn").addEventListener("click", function () { show("shop"); });

$("form").addEventListener("submit", function (e) {
  e.preventDefault();
  if (!validate()) return;
  var lines = "";
  cart.forEach(function (i) {
    lines += "<p>" + esc(i.name) + " \u2013 Size " + esc(i.size) + " \u00D7 " + i.quantity + " \u2013 " + money(i.price * i.quantity) + "</p>";
  });
  $("summary").innerHTML =
    "<p><strong>Order summary</strong></p>" + lines +
    "<p><strong>Total: " + money(cartTotal()) + " AUD</strong></p>" +
    "<p><strong>Deliver to:</strong><br>" + esc($("name").value.trim()) + "<br>" +
    esc($("street").value.trim()) + "<br>" + esc($("suburb").value.trim()) + " " + esc($("state").value) + " " + esc($("postcode").value.trim()) + "<br>" +
    esc($("email").value.trim()) + " \u00B7 " + esc($("phone").value.trim()) + "</p>" +
    "<p style='font-size:13px'>Demo checkout: this order has not been sent anywhere and no payment was taken.</p>";
  cart = []; save(); renderCount();
  show("done");
});

buildShop();
renderCount();
</script>
</body>
</html>
